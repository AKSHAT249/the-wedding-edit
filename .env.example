# Public site URL used for metadata, sitemap and social links.
# Example: https://www.example.com
NEXT_PUBLIC_SITE_URL=

# Enquiry delivery. Leave unset until a backend is connected.
# When set, POST /api/enquiry forwards a validated submission to this URL.
# The contact form shows success only if that request succeeds.
ENQUIRY_WEBHOOK_URL=

# Verified venue details. Leave blank until the business supplies them.
# Do not invent a phone number, address or email.
NEXT_PUBLIC_VENUE_PHONE=
NEXT_PUBLIC_VENUE_EMAIL=
NEXT_PUBLIC_VENUE_WHATSAPP=
NEXT_PUBLIC_VENUE_ADDRESS=
NEXT_PUBLIC_VENUE_HOURS=

# Google Maps embed URL, for example:
# https://www.google.com/maps/embed?pb=...
NEXT_PUBLIC_VENUE_MAPS_EMBED_URL=

# Optional https link that opens the venue in Google Maps.
NEXT_PUBLIC_VENUE_MAPS_LINK=

# Optional social profiles. Only https links are shown.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
